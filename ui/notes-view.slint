import { Theme } from "theme.slint";
import { Icons, SvgIcon } from "icons.slint";
import { DangerGhostButton, FocusTouchArea, GhostButton, IconButton } from "widgets.slint";
import { NoteItem } from "side-panel.slint";
import { ScrollView } from "std-widgets.slint";

export component NotesView inherits Rectangle {
    min-width: 0px;
    preferred-width: 0px;
    in property <[NoteItem]> notes;
    callback add-note(string, string) -> int;
    callback update-note(int, string, string) -> bool;
    callback delete-note(int);
    in-out property <int> selected-id: 0;
    in-out property <string> draft-title: "";
    in-out property <string> draft-content: "";
    in property <bool> compact-layout: false;
    private property <bool> delete-confirming: false;
    in-out property <string> save-status: root.selected-id == 0 ? "输入后自动保存" : "已保存";
    in-out property <bool> save-failed: false;
    private property <bool> title-focused: title-input.has-focus;
    private property <bool> body-focused: content-input.has-focus;
    private property <bool> edit-title: false;
    changed title-focused => { if root.title-focused { root.edit-title = true; } }
    changed body-focused => { if root.body-focused { root.edit-title = false; } }
    background: Theme.bg-app;

    public function auto-save-current() {
        if (root.selected-id != 0 || root.draft-title != "" || root.draft-content != "") {
            root.save-status = "保存中…";
            if (root.selected-id == 0) {
                root.selected-id = root.add-note(root.draft-title, root.draft-content);
                root.save-failed = root.selected-id == 0;
            } else {
                root.save-failed = !root.update-note(root.selected-id, root.draft-title, root.draft-content);
            }
            root.save-status = root.save-failed ? "保存失败 · Ctrl+S 重试" : "已保存";
        }
    }

    public function start-new-note() {
        if root.save-failed { root.auto-save-current(); }
        if root.save-failed { return; }
        root.selected-id = 0;
        root.draft-title = "";
        root.draft-content = "";
        root.delete-confirming = false;
        root.save-status = "输入后自动保存";
        title-input.focus();
    }

    public function focus-body() { content-input.focus(); }
    public function focus-title() { title-input.focus(); }
    public function undo-active() { if root.edit-title { title-input.undo(); } else { content-input.undo(); } }
    public function redo-active() { if root.edit-title { title-input.redo(); } else { content-input.redo(); } }

    shortcut-scope := FocusScope {
        width: parent.width;
        height: parent.height;
        KeyBinding {
            keys: @keys(Control + S);
            activated => { root.auto-save-current(); }
        }
        HorizontalLayout {
            width: parent.width;
            height: parent.height;
            padding: root.compact-layout ? Theme.space-3 : Theme.space-4;
            spacing: Theme.space-3;

        Rectangle {
            width: root.compact-layout ? 190px : 260px;
            border-radius: Theme.r-lg;
            border-width: 1px;
            border-color: Theme.border-subtle;
            background: Theme.bg-surface;
            clip: true;
            VerticalLayout {
                spacing: 0px;
                Rectangle {
                    height: 56px;
                    HorizontalLayout {
                        padding-left: Theme.space-4;
                        padding-right: Theme.space-3;
                        spacing: Theme.space-2;
                        cross-axis-alignment: center;
                        Text {
                            text: "全部便签";
                            color: Theme.text-1;
                            font-size: Theme.font-15;
                            font-weight: 700;
                            horizontal-stretch: 1;
                        }
                        Rectangle {
                            height: 22px;
                            min-width: 28px;
                            border-radius: 11px;
                            background: Theme.bg-surface-2;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                Text { text: notes.length; color: Theme.text-3; font-size: Theme.font-11; vertical-alignment: center; }
                            }
                        }
                        IconButton {
                            icon: Icons.plus;
                            accessible-name: "新建便签";
                            borderless: true;
                            clicked => { root.start-new-note(); }
                        }
                    }
                    Rectangle { x: 0; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.border-subtle; }
                }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 0px;
                        if notes.length == 0: Text {
                            height: 72px;
                            text: "还没有便签，点击右上角新建";
                            color: Theme.text-3;
                            font-size: Theme.font-12;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            wrap: word-wrap;
                        }
                        for note in notes: Rectangle {
                            height: 72px;
                            background: note-touch.has-hover || root.selected-id == note.id ? Theme.bg-selected : transparent;
                            border-width: note-touch.has-focus ? 2px : 0px;
                            border-color: Theme.accent;
                            accessible-role: button;
                            accessible-label: note.title == "" ? "无标题便签" : note.title;
                            accessible-action-default => { note-touch.clicked(); }
                            forward-focus: note-touch;
                            Rectangle { x: 0px; y: 0px; width: 3px; height: parent.height; background: root.selected-id == note.id ? Theme.accent : transparent; }
                            VerticalLayout {
                                padding-left: Theme.space-4;
                                padding-right: Theme.space-3;
                                padding-top: Theme.space-3;
                                padding-bottom: Theme.space-3;
                                spacing: 4px;
                                Text {
                                    text: note.title == "" ? "无标题便签" : note.title;
                                    color: Theme.text-1;
                                    font-size: Theme.font-13;
                                    font-weight: 600;
                                    overflow: elide;
                                }
                                Text {
                                    text: note.content == "" ? "暂无正文" : note.content;
                                    color: Theme.text-3;
                                    font-size: Theme.font-11;
                                    overflow: elide;
                                }
                            }
                            note-touch := FocusTouchArea {
                                width: parent.width;
                                height: parent.height;
                                clicked => {
                                    if root.save-failed { root.auto-save-current(); }
                                    if root.save-failed { return; }
                                    root.selected-id = note.id;
                                    root.draft-title = note.title;
                                    root.draft-content = note.content;
                                    root.delete-confirming = false;
                                    root.save-status = "已保存";
                                }
                            }
                        }
                    }
                }
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            border-radius: Theme.r-lg;
            border-width: 1px;
            border-color: Theme.border-subtle;
            background: Theme.bg-surface;
            clip: true;

            Rectangle {
                x: 0;
                y: 0;
                width: parent.width;
                height: 58px;
                background: Theme.bg-surface-2;
                HorizontalLayout {
                    padding-left: Theme.space-3;
                    padding-right: Theme.space-3;
                    spacing: Theme.space-2;
                    cross-axis-alignment: center;
                    IconButton {
                        icon: Icons.plus;
                        accessible-name: "新建便签";
                        borderless: true;
                        clicked => { root.start-new-note(); }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 38px;
                        background: transparent;
                        Text {
                            width: parent.width;
                            height: parent.height;
                            visible: root.draft-title == "";
                            text: "无标题便签";
                            color: Theme.text-3;
                            font-size: Theme.font-15;
                            font-weight: 650;
                            vertical-alignment: center;
                        }
                        title-input := TextInput {
                            width: parent.width;
                            height: parent.height;
                            text <=> root.draft-title;
                            color: Theme.text-1;
                            font-size: Theme.font-15;
                            font-weight: 650;
                            vertical-alignment: center;
                            selection-foreground-color: Theme.on-accent;
                            selection-background-color: Theme.accent;
                            edited => { root.auto-save-current(); }
                        }
                    }
                }
                Rectangle { x: 0; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.border-subtle; }
            }

            Rectangle {
                x: 0;
                y: 58px;
                width: parent.width;
                height: 44px;
                background: Theme.bg-surface;
                HorizontalLayout {
                    padding-left: Theme.space-4;
                    padding-right: Theme.space-4;
                    spacing: Theme.space-2;
                    cross-axis-alignment: center;
                    GhostButton { height: 28px; text: "撤销"; clicked => { root.undo-active(); } }
                    GhostButton { height: 28px; text: "重做"; clicked => { root.redo-active(); } }
                    Rectangle { width: 1px; height: 20px; background: Theme.border-subtle; }
                    GhostButton { height: 28px; text: "剪切"; clicked => { if root.edit-title { title-input.cut(); } else { content-input.cut(); } } }
                    GhostButton { height: 28px; text: "复制"; clicked => { if root.edit-title { title-input.copy(); } else { content-input.copy(); } } }
                    GhostButton { height: 28px; text: "粘贴"; clicked => { if root.edit-title { title-input.paste(); } else { content-input.paste(); } } }
                    Rectangle { horizontal-stretch: 1; }
                }
                Rectangle { x: 0; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.border-subtle; }
            }

            Text {
                x: Theme.space-6;
                y: 118px;
                width: parent.width - Theme.space-6 * 2;
                visible: root.draft-content == "";
                text: "开始记录想法、清单或会议要点…";
                color: Theme.text-3;
                font-size: Theme.font-15;
            }
            body-scroll := ScrollView {
                x: Theme.space-4; y: 114px;
                width: parent.width - Theme.space-4 * 2;
                height: parent.height - 172px;
                viewport-width: self.visible-width;
                viewport-height: max(self.visible-height, content-input.preferred-height);
                content-input := TextInput {
                    x: 0px; y: 0px;
                    width: body-scroll.visible-width;
                    height: max(body-scroll.visible-height, self.preferred-height);
                    text <=> root.draft-content;
                    color: Theme.text-1; font-size: Theme.font-15;
                    single-line: false; wrap: word-wrap;
                    page-height: body-scroll.visible-height;
                    selection-foreground-color: Theme.on-accent;
                    selection-background-color: Theme.accent;
                    edited => { root.auto-save-current(); }
                    cursor-position-changed(pos) => {
                        if pos.y + body-scroll.viewport-y < 0px {
                            body-scroll.viewport-y = -pos.y;
                        } else if pos.y + body-scroll.viewport-y > body-scroll.visible-height - 24px {
                            body-scroll.viewport-y = min(0px, body-scroll.visible-height - pos.y - 24px);
                        }
                    }
                }
            }

            Rectangle {
                x: 0;
                y: parent.height - 50px;
                width: parent.width;
                height: 50px;
                background: Theme.bg-surface-2;
                HorizontalLayout {
                    padding-left: Theme.space-4;
                    padding-right: Theme.space-3;
                    spacing: Theme.space-2;
                    cross-axis-alignment: center;
                    Rectangle { horizontal-stretch: 1; }
                    if root.delete-confirming: Text {
                        text: "确定删除这张便签？";
                        color: Theme.danger;
                        font-size: Theme.font-11;
                        vertical-alignment: center;
                    }
                    if root.delete-confirming: DangerGhostButton {
                        height: 32px;
                        text: "确认删除";
                        clicked => {
                            root.delete-note(root.selected-id);
                            root.selected-id = 0;
                            root.draft-title = "";
                            root.draft-content = "";
                            root.delete-confirming = false;
                        }
                    }
                    if root.delete-confirming: GhostButton { text: "取消"; clicked => { root.delete-confirming = false; } }
                    if !root.delete-confirming && root.selected-id != 0: IconButton {
                        icon: Icons.trash;
                        accessible-name: "删除便签";
                        borderless: true;
                        clicked => { root.delete-confirming = true; }
                    }
                    if !root.delete-confirming: Text {
                        text: root.save-status;
                        color: root.save-failed ? Theme.danger : Theme.text-3;
                        font-size: Theme.font-11;
                        vertical-alignment: center;
                    }
                }
                Rectangle { x: 0; y: 0; width: parent.width; height: 1px; background: Theme.border-subtle; }
            }
        }
    }
    }
}
