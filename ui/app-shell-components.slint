import { Theme } from "design-system.slint";
import { CalendarDay } from "calendar-view.slint";
import { SvgIcon } from "icons.slint";
import { FocusTouchArea } from "widgets.slint";

export component MainWindowDragArea inherits TouchArea {
    callback drag-requested();
    callback maximize-requested();
    mouse-cursor: default;
    changed pressed => {
        if self.pressed {
            root.drag-requested();
        }
    }
    double-clicked => { root.maximize-requested(); }
}

export component MiniDay inherits Rectangle {
    in property <CalendarDay> data;
    in property <bool> selected: false;
    callback clicked();

    height: 24px;
    // Calendar rows must divide the available width into seven identical
    // columns. Without neutral layout hints, one- and two-digit labels report
    // different preferred widths and HorizontalLayout subtly shifts columns.
    min-width: 0px;
    preferred-width: 0px;
    border-radius: Theme.radius-sm;
    background: data.is-today ? Theme.today-bg : (selected ? Theme.accent-soft : transparent);
    border-width: touch.has-focus ? 2px : 0px;
    border-color: Theme.accent;
    accessible-role: button;
    accessible-label: data.in-current-month ? "选择 " + data.day + " 日" : "非本月日期";
    accessible-action-default => { if (data.in-current-month) { root.clicked(); } }
    forward-focus: touch;
    touch := FocusTouchArea { enabled: data.in-current-month; clicked => { root.clicked(); } }

    Text {
        text: data.day;
        color: data.is-today ? Theme.today-text : (!data.in-current-month ? Theme.text-muted : (data.is-weekend || data.is-holiday ? Theme.weekend-text : Theme.text-primary));
        font-size: Theme.font-xs;
        font-weight: data.is-today || selected ? 700 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component ToolbarButton inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    in property <length> button-width: 40px;
    callback clicked <=> touch.clicked;
    width: button-width; height: 26px; border-radius: 6px;
    background: selected ? Theme.bg-surface : (touch.has-hover ? Theme.bg-hover : transparent);
    border-width: touch.has-focus ? 2px : 0px;
    border-color: Theme.accent;
    drop-shadow-color: selected ? Theme.shadow-1-color-a : transparent;
    drop-shadow-blur: selected ? Theme.shadow-1-blur-a : 0px;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    forward-focus: touch;
    touch := FocusTouchArea { }
    Text { text: root.label; color: selected ? Theme.text-1 : Theme.text-2; font-size: Theme.font-12; font-weight: selected ? 600 : 400; horizontal-alignment: center; vertical-alignment: center; }
}

export component SidebarQuickAction inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> selected: false;
    callback clicked();

    height: 48px;
    border-radius: Theme.r-md;
    background: selected ? Theme.accent-subtle : (touch.has-hover ? Theme.bg-hover : transparent);
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    forward-focus: touch;
    border-width: touch.has-focus ? 2px : 0px;
    border-color: Theme.accent;
    touch := FocusTouchArea { clicked => { root.clicked(); } }
    VerticalLayout {
        padding-top: 6px;
        padding-bottom: 5px;
        spacing: 3px;
        alignment: center;
        SvgIcon { source: root.icon; size: 15px; tint: root.selected ? Theme.accent : Theme.text-2; }
        Text {
            text: root.label;
            color: root.selected ? Theme.accent : Theme.text-2;
            font-size: Theme.font-10;
            font-weight: root.selected ? 600 : 400;
            horizontal-alignment: center;
        }
    }
}

export component OverviewMetricCard inherits Rectangle {
    in property <string> label;
    in property <string> value;

    height: 66px;
    border-radius: Theme.r-md;
    border-width: 1px;
    border-color: Theme.border-subtle;
    background: Theme.bg-surface;

    Text {
        x: 10px; y: 8px; width: parent.width - 20px; height: 20px;
        text: root.label;
        color: Theme.text-2; font-size: Theme.font-12; vertical-alignment: center;
    }
    Text {
        x: 10px; y: 28px; width: parent.width - 20px; height: 26px;
        text: root.value;
        color: Theme.text-1; font-size: Theme.font-18; font-weight: 700; vertical-alignment: center;
    }
}

export component DesktopWidgetManagerItem inherits Rectangle {
    in property <string> label;
    in property <string> description;
    in property <image> icon;
    in property <bool> installed;
    callback toggled(bool);

    height: 72px;
    border-radius: Theme.r-md;
    border-width: 1px;
    border-color: installed ? Theme.accent : Theme.border-default;
    background: item-touch.has-hover ? Theme.bg-hover : Theme.bg-surface-2;
    accessible-role: button;
    accessible-label: (root.installed ? "删除" : "新建") + root.label + "桌面卡片";
    accessible-action-default => { root.toggled(!root.installed); }
    forward-focus: item-touch;
    item-touch := FocusTouchArea { clicked => { root.toggled(!root.installed); } }
    HorizontalLayout {
        padding-left: Theme.space-3; padding-right: Theme.space-3; spacing: Theme.space-3; cross-axis-alignment: center;
        Rectangle {
            width: 34px; height: 34px; border-radius: Theme.r-md;
            background: root.installed ? Theme.accent-soft : Theme.bg-surface;
            SvgIcon { source: root.icon; size: 18px; tint: root.installed ? Theme.accent : Theme.text-2; x: 8px; y: 8px; }
        }
        VerticalLayout {
            horizontal-stretch: 1; spacing: 2px; alignment: center;
            Text { text: root.label; color: Theme.text-1; font-size: Theme.font-13; font-weight: 600; }
            Text { text: root.description; color: Theme.text-3; font-size: Theme.font-10-5; overflow: elide; }
        }
        Rectangle {
            width: 54px; height: 28px; border-radius: Theme.r-md;
            border-width: root.installed ? 1px : 0px;
            border-color: root.installed ? Theme.danger : Theme.accent;
            background: root.installed ? transparent : Theme.accent;
            Text { text: root.installed ? "删除" : "新建"; color: root.installed ? Theme.danger : Theme.on-accent; font-size: Theme.font-11; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
        }
    }
}
