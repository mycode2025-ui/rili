import { Theme } from "theme.slint";
import { Icons, SvgIcon } from "icons.slint";
import { EventItem, TodoItem } from "side-panel.slint";
import { CountdownItem } from "widget.slint";
import { ScrollView } from "std-widgets.slint";
import { FocusTouchArea } from "widgets.slint";

component Card inherits Rectangle {
    background: Theme.bg-surface;
    border-width: 1px;
    border-color: Theme.border-subtle;
    border-radius: Theme.r-lg;
    drop-shadow-color: Theme.shadow-1-color-a;
    drop-shadow-blur: Theme.shadow-1-blur-a;
    drop-shadow-offset-y: Theme.shadow-1-y;
}

component CheckMark inherits Rectangle {
    in property <bool> checked;
    width: 16px; height: 16px; border-radius: 5px;
    border-width: checked ? 0px : 1.5px;
    border-color: Theme.border-strong;
    background: checked ? Theme.accent : transparent;
    if checked: SvgIcon { source: Icons.check; size: 11px; tint: Theme.on-accent; x: 2.5px; y: 2.5px; }
}

component TodayEventRow inherits Rectangle {
    in property <EventItem> event;
    in property <int> current-minutes;
    in property <int> next-event-id;
    private property <bool> is-next: event.id == next-event-id && !event.all-day && event.start-minutes > current-minutes;
    private property <string> timing: event.all-day ? "全天" : event.start-minutes + event.duration-minutes <= current-minutes ? "已结束" : event.start-minutes <= current-minutes ? "进行中" : root.is-next ? "下一场" : "未开始";
    callback clicked <=> touch.clicked;
    height: 58px;
    min-width: 0px;
    preferred-width: 0px;
    horizontal-stretch: 1;
    border-radius: Theme.r-md;
    background: root.is-next ? Theme.accent-subtle : transparent;
    border-width: touch.has-focus ? 2px : 0px;
    border-color: Theme.accent;
    accessible-role: button;
    accessible-label: event.title + "，" + event.time-text;
    accessible-action-default => { root.clicked(); }
    forward-focus: touch;
    touch := FocusTouchArea { width: parent.width; height: parent.height; }
    HorizontalLayout {
        width: 100%; height: 100%;
        padding-left: Theme.space-2; padding-right: Theme.space-2; spacing: 10px;
        cross-axis-alignment: center;
        Rectangle { width: 3px; height: 42px; border-radius: 2px; background: event.color; }
        Text { width: 40px; text: event.all-day ? "全天" : event.time-text; color: root.is-next ? Theme.accent : Theme.text-3; font-size: Theme.font-12; vertical-alignment: top; }
        VerticalLayout {
            min-width: 0px;
            horizontal-stretch: 1;
            alignment: center; spacing: 3px;
            Text { min-width: 0px; horizontal-stretch: 1; text: event.title; color: Theme.text-1; font-size: Theme.font-13; font-weight: 600; overflow: elide; }
            Text { min-width: 0px; horizontal-stretch: 1; text: root.timing + (event.meta-text != "" ? " · " + event.meta-text : ""); color: root.is-next ? Theme.accent : Theme.text-3; font-size: Theme.font-12; overflow: elide; }
        }
    }
}

component TodayTodoRow inherits Rectangle {
    in property <TodoItem> todo;
    callback toggle();
    height: 32px;
    border-width: touch.has-focus ? 2px : 0px;
    border-color: Theme.accent;
    accessible-role: checkbox;
    accessible-label: todo.title;
    accessible-checked: todo.done;
    accessible-action-default => { root.toggle(); }
    forward-focus: touch;
    touch := FocusTouchArea { width: parent.width; height: parent.height; clicked => { toggle(); } }
    HorizontalLayout {
        width: 100%; height: 100%;
        padding-left: Theme.space-2; padding-right: Theme.space-2; spacing: Theme.space-2;
        cross-axis-alignment: center;
        CheckMark { checked: todo.done; }
        Text { text: todo.title; color: todo.done ? Theme.text-disabled : Theme.text-1; font-size: Theme.font-13; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
        if !todo.done: Text { text: todo.meta-text; color: todo.is-overdue ? Theme.danger : Theme.text-3; font-size: Theme.font-11; vertical-alignment: center; }
    }
}

component CardHeader inherits Rectangle {
    in property <string> title;
    in property <string> meta: "";
    callback add-clicked();
    height: 56px;
    border-width: 1px;
    border-color: Theme.border-subtle;
    HorizontalLayout {
        width: 100%; height: 100%;
        padding-left: Theme.space-4; padding-right: Theme.space-4; spacing: Theme.space-2;
        Text { text: root.title; color: Theme.text-1; font-size: Theme.font-13; font-weight: 600; vertical-alignment: center; }
        Rectangle { horizontal-stretch: 1; }
        Text { text: root.meta; color: Theme.text-3; font-size: Theme.font-11; vertical-alignment: center; }
        Rectangle { width: 28px; height: 28px; border-radius: Theme.r-md; background: add-touch.has-hover ? Theme.bg-hover : transparent;
            accessible-role: button;
            accessible-label: "添加" + root.title;
            accessible-action-default => { root.add-clicked(); }
            forward-focus: add-touch;
            SvgIcon { source: Icons.plus; size: 14px; tint: Theme.text-3; x: 7px; y: 7px; }
            add-touch := FocusTouchArea { width: parent.width; height: parent.height; clicked => { root.add-clicked(); } }
        }
    }
}

component Fact inherits Rectangle {
    in property <string> label;
    in property <string> value;
    width: 76px; height: 66px;
    VerticalLayout {
        width: 100%; height: 100%;
        alignment: center; spacing: Theme.space-1;
        Text { text: root.label; color: Theme.text-3; font-size: Theme.font-11; horizontal-alignment: center; }
        Text { text: root.value; color: Theme.text-1; font-size: Theme.font-20; font-weight: 700; horizontal-alignment: center; }
    }
}

component CountdownCard inherits Rectangle {
    in property <CountdownItem> item;
    callback clicked <=> touch.clicked;
    horizontal-stretch: 1;
    height: 96px;
    border-radius: Theme.r-md;
    border-width: 1px;
    border-color: Theme.border-subtle;
    background: Theme.bg-surface-2;
    accessible-role: button;
    accessible-label: item.title + "，" + item.days + "天";
    accessible-action-default => { root.clicked(); }
    forward-focus: touch;
    touch := FocusTouchArea { width: parent.width; height: parent.height; }
    VerticalLayout {
        width: 100%; height: 100%;
        padding: Theme.space-3; spacing: 2px;
        Text { text: root.item.title; color: Theme.text-2; font-size: Theme.font-12; overflow: elide; }
        Text { text: root.item.days + " 天"; color: root.item.days <= 7 ? Theme.danger : Theme.text-1; font-size: Theme.font-22; font-weight: 700; }
        Text { text: root.item.date-text; color: Theme.text-3; font-size: Theme.font-11; overflow: elide; }
    }
}

export component TodayView inherits Rectangle {
    in property <int> current-minutes;
    in property <int> next-event-id: -1;
    private property <bool> compact: root.width < 820px;
    in property <[EventItem]> events;
    in property <[TodoItem]> todos;
    in property <[CountdownItem]> countdowns;
    in property <int> todo-completed-count;
    in property <string> day-text: "";
    in property <string> date-heading: "";
    in property <string> lunar-heading: "";
    in property <string> day-of-year-text: "";
    in property <string> week-number-text: "";
    in property <string> remaining-days-text: "";
    in property <string> weather-fact-text: "--";
    in property <float> year-progress: 0;
    in property <string> year-progress-text: "";
    in property <string> year-progress-label: "";
    in property <string> next-event-text: "";
    in property <string> next-event-status: "";
    callback toggle-todo(int);
    callback add-event();
    callback add-todo();
    callback add-countdown();
    callback open-event(int, string);
    callback open-countdown();
    background: Theme.bg-app;
    min-width: 0px;
    min-height: 0px;
    clip: true;

    ScrollView {
    width: 100%; height: 100%;
    VerticalLayout {
        x: 0px; y: 0px;
        width: parent.visible-width;
        height: max(self.preferred-height, root.height);
        padding: Theme.space-4;
        spacing: Theme.space-4;
        Card {
            height: root.compact ? 166px : 106px;
            GridLayout {
                padding: 16px; spacing: 12px;
                HorizontalLayout {
                    col: 0; row: 0; spacing: 12px;
                    Text { width: 56px; horizontal-stretch: 0; text: root.day-text; color: Theme.text-1; font-size: Theme.font-40; font-weight: 700; }
                    VerticalLayout {
                        alignment: center;
                        Text { text: root.date-heading; color: Theme.text-1; font-size: Theme.font-20; font-weight: 600; }
                        Text { text: root.lunar-heading; color: Theme.text-2; font-size: Theme.font-13; overflow: elide; }
                    }
                }
                HorizontalLayout {
                    col: root.compact ? 0 : 1; row: root.compact ? 1 : 0;
                    spacing: 8px;
                    Fact { label: "一年中第"; value: root.day-of-year-text; }
                    Fact { label: "第几周"; value: root.week-number-text; }
                    Fact { label: "剩余"; value: root.remaining-days-text; }
                    Fact { label: "天气"; value: root.weather-fact-text; }
                }
            }
        }
        if next-event-text != "": Rectangle {
            height: 40px; border-radius: Theme.r-md; background: Theme.accent-subtle;
            HorizontalLayout {
                width: 100%; height: 100%;
                padding-left: Theme.space-3; padding-right: Theme.space-3; spacing: Theme.space-2;
                cross-axis-alignment: center;
                SvgIcon { source: Icons.clock; size: 14px; tint: Theme.accent; }
                Text { text: root.next-event-text; color: Theme.accent; font-size: Theme.font-12; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                Text { text: root.next-event-status; color: Theme.accent; font-size: Theme.font-12; vertical-alignment: center; }
            }
        }
        GridLayout {
            spacing: Theme.space-4;
            min-height: 0px;
            vertical-stretch: 1;
            Card {
                col: 0;
                row: 0;
                min-height: root.events.length == 0 ? 110px : 230px;
                min-width: 0px;
                preferred-width: 0px;
                horizontal-stretch: 1;
                clip: true;
                VerticalLayout {
                    width: 100%; height: 100%;
                    spacing: 0px;
                    CardHeader { title: "今日日程"; meta: events.length + " 个"; add-clicked => { root.add-event(); } }
                    Rectangle {
                        min-height: 0px;
                        vertical-stretch: 1;
                        clip: true;
                        ScrollView {
                            width: 100%; height: 100%;
                            VerticalLayout {
                                width: 100%; padding: Theme.space-3; spacing: 0px;
                                for event in events: TodayEventRow { event: event; current-minutes: root.current-minutes; next-event-id: root.next-event-id; clicked => { root.open-event(event.id, event.occurrence-date); } }
                                if events.length == 0: Text { height: 40px; text: "今天没有安排"; color: Theme.text-3; font-size: Theme.font-12; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                    }
                }
            }
            Card {
                col: root.compact ? 0 : 1;
                row: root.compact ? 1 : 0;
                min-height: root.todos.length == 0 ? 110px : 230px;
                min-width: 0px;
                preferred-width: 0px;
                horizontal-stretch: 1;
                clip: true;
                VerticalLayout {
                    width: 100%; height: 100%;
                    spacing: 0px;
                    CardHeader { title: "今日待办"; meta: root.todo-completed-count + " / " + todos.length; add-clicked => { root.add-todo(); } }
                    Rectangle {
                        min-height: 0px;
                        vertical-stretch: 1;
                        clip: true;
                        ScrollView {
                            width: 100%; height: 100%;
                            VerticalLayout {
                                width: 100%; padding: Theme.space-3; spacing: 0px;
                                for todo in todos: TodayTodoRow { todo: todo; toggle => { root.toggle-todo(todo.id); } }
                                if todos.length == 0: Text { height: 40px; text: "今天没有待办"; color: Theme.text-3; font-size: Theme.font-12; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                    }
                }
            }
        }
        Card {
            height: countdowns.length > 0 ? 256px : 146px;
            VerticalLayout {
                width: 100%; height: 100%;
                spacing: 0px;
                CardHeader { title: "倒数日"; add-clicked => { root.add-countdown(); } }
                VerticalLayout {
                    padding: Theme.space-4; spacing: Theme.space-4;
                    if countdowns.length > 0: ScrollView {
                        height: 110px;
                        viewport-width: max(self.visible-width, countdowns.length * 232px);
                        HorizontalLayout {
                            spacing: Theme.space-3;
                            for item in countdowns: CountdownCard { min-width: 220px; item: item; clicked => { root.open-countdown(); } }
                        }
                    }
                    if countdowns.length == 0: Text { height: 40px; text: "还没有倒数日，可在记录页添加"; color: Theme.text-3; font-size: Theme.font-12; horizontal-alignment: center; vertical-alignment: center; }
                    HorizontalLayout {
                        Text { text: root.year-progress-label; color: Theme.text-2; font-size: Theme.font-12; }
                        Rectangle { horizontal-stretch: 1; }
                        Text { text: root.year-progress-text; color: Theme.text-2; font-size: Theme.font-12; }
                    }
                    Rectangle {
                        height: 8px; border-radius: Theme.pill-radius-8; border-width: 1px; border-color: Theme.border-subtle; background: Theme.bg-surface-2;
                        Rectangle { x: 1px; y: 1px; width: (parent.width - 2px) * root.year-progress; height: parent.height - 2px; border-radius: Theme.pill-radius-8; background: Theme.accent; }
                    }
                }
            }
        }
    }
    }
}
