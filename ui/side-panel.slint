import { Theme } from "theme.slint";
import { Icons, SvgIcon } from "icons.slint";

export struct EventItem {
    id: int,
    title: string,
    time-text: string,
    meta-text: string,
    color: color,
    start-minutes: int,
    duration-minutes: int,
    all-day: bool,
    lane: int,
    lane-count: int,
}
export struct TodoItem { id: int, title: string, done: bool, priority: int }
export struct NoteItem { id: int, title: string, content: string }
export struct HabitItem { id: int, title: string, streak: int, done-today: bool }
export struct CalendarItem { id: int, name: string, color: color, visible: bool }

component CheckMark inherits Rectangle {
    in property <bool> checked;
    width: 16px; height: 16px; border-radius: 5px;
    border-width: checked ? 0px : 1.5px;
    border-color: Theme.border-strong;
    background: checked ? Theme.accent : transparent;
    if checked: SvgIcon { source: Icons.check; size: 11px; tint: Theme.on-accent; x: 2.5px; y: 2.5px; }
}

component SectionTitle inherits HorizontalLayout {
    in property <string> text;
    in property <string> meta: "";
    height: 28px;
    Text { text: root.text; color: Theme.text-3; font-size: Theme.font-11; font-weight: 600; vertical-alignment: center; }
    Rectangle { horizontal-stretch: 1; }
    if root.meta != "": Text { text: root.meta; color: Theme.text-3; font-size: Theme.font-11; vertical-alignment: center; }
}

component AgendaRow inherits Rectangle {
    in property <EventItem> event;
    callback open();
    height: 58px; border-radius: Theme.r-md;
    background: touch.has-hover ? Theme.bg-hover : transparent;
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.open(); } }
    HorizontalLayout {
        padding-left: Theme.space-2; padding-right: Theme.space-2; spacing: 10px;
        Rectangle { width: 3px; height: 42px; border-radius: 2px; background: event.color; }
        Text { width: 34px; text: event.time-text == "" ? "全天" : event.time-text; color: Theme.text-3; font-size: Theme.font-11; vertical-alignment: top; }
        VerticalLayout {
            alignment: center; spacing: 3px;
            Text { text: event.title; color: Theme.text-1; font-size: Theme.font-13; font-weight: 600; overflow: elide; }
            Text { text: event.meta-text; color: Theme.text-3; font-size: Theme.font-11; overflow: elide; }
        }
    }
}

component TodoRow inherits Rectangle {
    in property <TodoItem> todo;
    callback toggle();
    height: 32px; border-radius: Theme.r-md;
    background: touch.has-hover ? Theme.bg-hover : transparent;
    touch := TouchArea { mouse-cursor: pointer; clicked => { toggle(); } }
    HorizontalLayout {
        padding-left: Theme.space-2; padding-right: Theme.space-2; spacing: Theme.space-2;
        cross-axis-alignment: center;
        CheckMark { checked: todo.done; }
        Text { text: todo.title; color: todo.done ? Theme.text-disabled : Theme.text-1; font-size: Theme.font-13; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
        if !todo.done: Text { text: todo.priority > 1 ? "逾期 2 天" : "今天"; color: todo.priority > 1 ? Theme.danger : Theme.text-3; font-size: Theme.font-11; vertical-alignment: center; }
    }
}

export component SidePanel inherits Rectangle {
    in property <string> selected-date-text;
    in property <[EventItem]> events-for-day;
    in property <[TodoItem]> todos-for-day;
    in property <[NoteItem]> notes;
    in property <[HabitItem]> habits;
    in property <[CalendarItem]> calendars;
    in property <[string]> calendar-names;
    in-out property <int> selected-section: 0;
    callback request-add(string);
    callback open-event(int);
    callback open-note(int);
    callback add-event(string, string, string, string, int);
    callback delete-event(int);
    callback add-todo(string);
    callback toggle-todo(int);
    callback delete-todo(int);
    callback add-note(string, string);
    callback update-note(int, string, string);
    callback delete-note(int);
    callback add-habit(string);
    callback toggle-habit(int);
    callback delete-habit(int);
    callback toggle-calendar-visible(int, bool);
    callback add-calendar(string);

    width: Theme.w-inspector;
    background: Theme.bg-surface;
    border-width: 1px;
    border-color: Theme.border-subtle;

    VerticalLayout {
        padding-left: Theme.space-4; padding-right: Theme.space-4; padding-top: Theme.space-4; spacing: 0px;
        Text { text: selected-date-text; color: Theme.text-1; font-size: Theme.font-16; font-weight: 700; overflow: elide; }
        Text { text: "农历七月十九 · 第 243 天 · 第 36 周"; color: Theme.text-2; font-size: Theme.font-12; }
        Rectangle { height: Theme.space-2; }
        HorizontalLayout {
            height: 24px; spacing: 6px;
            for chip[i] in ["日程 " + events-for-day.length, "待办 " + todos-for-day.length, "便签 " + notes.length, "添加"]: Rectangle {
                height: 22px; border-radius: Theme.pill-radius-22;
                border-width: i == root.selected-section ? 0px : 1px; border-color: Theme.border-default;
                background: i == root.selected-section ? Theme.accent-subtle : Theme.bg-surface-2;
                TouchArea { mouse-cursor: pointer; clicked => {
                    if (i < 3) { root.selected-section = i; }
                    else { root.request-add(root.selected-section == 0 ? "event" : (root.selected-section == 1 ? "todo" : "note")); }
                } }
                HorizontalLayout {
                    padding-left: Theme.space-2; padding-right: Theme.space-2; spacing: Theme.space-1;
                    cross-axis-alignment: center;
                    if i == 3: SvgIcon { source: Icons.plus; size: 12px; tint: Theme.text-2; }
                    Text { text: chip; color: i == root.selected-section ? Theme.accent : Theme.text-2; font-size: Theme.font-11; font-weight: i == root.selected-section ? 600 : 400; vertical-alignment: center; }
                }
            }
        }
        Rectangle { height: Theme.space-3; }
        if root.selected-section == 0: SectionTitle { text: "今日日程"; }
        for event in events-for-day: AgendaRow { visible: root.selected-section == 0; event: event; open => { root.open-event(event.id); } }
        if root.selected-section == 0 && events-for-day.length == 0: Text { text: "今天没有安排"; color: Theme.text-3; font-size: Theme.font-12; }
        if root.selected-section == 1: SectionTitle { text: "今日待办"; meta: todos-for-day.length + " 项"; }
        for todo in todos-for-day: TodoRow { visible: root.selected-section == 1; todo: todo; toggle => { root.toggle-todo(todo.id); } }
        if root.selected-section == 1 && todos-for-day.length == 0: Text { text: "今天没有待办"; color: Theme.text-3; font-size: Theme.font-12; }
        if root.selected-section == 2: SectionTitle { text: "关联便签"; }
        if root.selected-section == 2 && notes.length > 0: Rectangle {
            height: 36px; border-radius: Theme.r-md; border-width: 1px; border-color: Theme.border-subtle; background: Theme.bg-surface-2;
            TouchArea { mouse-cursor: pointer; clicked => { root.open-note(notes[0].id); } }
            HorizontalLayout {
                padding-left: Theme.space-2; padding-right: Theme.space-2; spacing: Theme.space-2;
                cross-axis-alignment: center;
                SvgIcon { source: Icons.note; size: 16px; tint: Theme.text-3; }
                Text { text: notes[0].title; color: Theme.text-1; font-size: Theme.font-12; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                SvgIcon { source: Icons.arrow-right; size: 14px; tint: Theme.text-3; }
            }
        }
        if root.selected-section == 2 && notes.length == 0: Text { text: "还没有便签"; color: Theme.text-3; font-size: Theme.font-12; }
        Rectangle { vertical-stretch: 1; }
    }
}
