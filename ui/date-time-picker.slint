import { Theme } from "theme.slint";
import { Icons, SvgIcon } from "icons.slint";

component PickerButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> selected: false;
    callback clicked();
    height: 34px;
    border-radius: Theme.r-md;
    border-width: primary ? 0px : 1px;
    border-color: selected ? Theme.accent : Theme.border-default;
    background: primary ? Theme.accent : (selected ? Theme.accent-subtle : (touch.has-hover ? Theme.bg-hover : Theme.bg-surface));
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    Text {
        text: root.label;
        color: primary ? Theme.on-accent : (selected ? Theme.accent : Theme.text-1);
        font-size: Theme.font-14;
        font-weight: primary || selected ? 600 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component IconPickerButton inherits Rectangle {
    in property <image> icon;
    callback clicked();
    width: 34px; height: 34px;
    border-radius: Theme.r-md;
    background: touch.has-hover ? Theme.bg-hover : transparent;
    SvgIcon { source: root.icon; size: 16px; tint: Theme.text-1; x: 9px; y: 9px; }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component CalendarDayButton inherits Rectangle {
    in property <int> day;
    in property <bool> selected;
    in property <bool> weekend;
    callback clicked();
    height: 34px;
    border-radius: 17px;
    background: selected ? Theme.accent : (touch.has-hover && day > 0 ? Theme.bg-hover : transparent);
    touch := TouchArea { enabled: root.day > 0; mouse-cursor: root.day > 0 ? pointer : default; clicked => { root.clicked(); } }
    Text {
        text: root.day > 0 ? root.day : "";
        color: selected ? Theme.on-accent : (weekend ? Theme.weekend : Theme.text-1);
        font-size: Theme.font-14;
        font-weight: selected ? 700 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component TimeHubDatePickerPopup inherits PopupWindow {
    in property <string> title: "选择日期";
    in property <bool> compact: false;
    in property <bool> auto-accept: false;
    in-out property <int> year: 2026;
    in-out property <int> month: 9;
    in-out property <int> day: 1;
    in-out property <int> page-mode: 0; // 0 日历，1 年，2 月
    callback accepted(int, int, int);
    callback canceled();

    pure function month-code(value: int) -> int {
        return value == 1 ? 0 : (value == 2 ? 3 : (value == 3 ? 2 : (value == 4 ? 5 :
            (value == 5 ? 0 : (value == 6 ? 3 : (value == 7 ? 5 : (value == 8 ? 1 :
            (value == 9 ? 4 : (value == 10 ? 6 : (value == 11 ? 2 : 4))))))))));
    }
    pure function weekday(value-year: int, value-month: int, value-day: int) -> int {
        return Math.mod((value-month < 3 ? value-year - 1 : value-year)
            + Math.floor((value-month < 3 ? value-year - 1 : value-year) / 4)
            - Math.floor((value-month < 3 ? value-year - 1 : value-year) / 100)
            + Math.floor((value-month < 3 ? value-year - 1 : value-year) / 400)
            + root.month-code(value-month) + value-day, 7);
    }
    pure function first-offset() -> int { return Math.mod(root.weekday(root.year, root.month, 1) + 6, 7); }
    pure function leap(value-year: int) -> bool { return Math.mod(value-year, 400) == 0 || (Math.mod(value-year, 4) == 0 && Math.mod(value-year, 100) != 0); }
    pure function days-in-month(value-year: int, value-month: int) -> int {
        return value-month == 2 ? (root.leap(value-year) ? 29 : 28) :
            ((value-month == 4 || value-month == 6 || value-month == 9 || value-month == 11) ? 30 : 31);
    }
    pure function year-base() -> int { return Math.floor(root.year / 12) * 12; }
    function clamp-day() {
        if root.day > root.days-in-month(root.year, root.month) { root.day = root.days-in-month(root.year, root.month); }
    }
    function previous-page() {
        if root.page-mode == 1 { root.year -= 12; }
        else if root.page-mode == 2 { root.year -= 1; }
        else if root.month == 1 { root.month = 12; root.year -= 1; }
        else { root.month -= 1; }
        root.clamp-day();
    }
    function next-page() {
        if root.page-mode == 1 { root.year += 12; }
        else if root.page-mode == 2 { root.year += 1; }
        else if root.month == 12 { root.month = 1; root.year += 1; }
        else { root.month += 1; }
        root.clamp-day();
    }

    width: root.compact ? 340px : 360px;
    height: root.compact ? 312px : (root.page-mode == 0 ? (root.first-offset() + root.days-in-month(root.year, root.month) > 35 ? 446px : 410px) : 300px);
    close-policy: PopupClosePolicy.no-auto-close;

    Rectangle {
        width: 100%; height: 100%;
        background: Theme.bg-surface;
        border-width: 1px;
        border-color: Theme.border-default;
        border-radius: Theme.r-lg;
        drop-shadow-color: Theme.shadow-3-color-a;
        drop-shadow-blur: Theme.shadow-3-blur-a;
        drop-shadow-offset-y: Theme.shadow-3-y-a;
        clip: true;

        VerticalLayout {
            spacing: 0px;
            Rectangle {
                height: root.compact ? 40px : 48px; background: Theme.bg-surface-2;
                HorizontalLayout { padding-left: 16px; padding-right: 10px; spacing: 8px; cross-axis-alignment: center;
                    SvgIcon { source: Icons.calendar; size: 18px; tint: Theme.accent; }
                    Text { text: root.title; color: Theme.text-1; font-size: root.compact ? Theme.font-16 : Theme.font-18; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                    IconPickerButton { icon: Icons.close; clicked => { root.page-mode = 0; root.close(); root.canceled(); } }
                }
            }
            VerticalLayout {
                padding-left: 14px; padding-right: 14px; padding-top: root.compact ? 6px : 10px; padding-bottom: root.compact ? 6px : 10px; spacing: root.compact ? 4px : 8px;
                HorizontalLayout { height: root.compact ? 32px : 36px; spacing: 6px; cross-axis-alignment: center;
                    IconPickerButton { icon: Icons.left; clicked => { root.previous-page(); } }
                    Rectangle { horizontal-stretch: 1; }
                    PickerButton { width: 94px; label: root.year + " 年"; selected: root.page-mode == 1; clicked => { root.page-mode = root.page-mode == 1 ? 0 : 1; } }
                    PickerButton { width: 72px; label: root.month + " 月"; selected: root.page-mode == 2; clicked => { root.page-mode = root.page-mode == 2 ? 0 : 2; } }
                    Rectangle { horizontal-stretch: 1; }
                    IconPickerButton { icon: Icons.right; clicked => { root.next-page(); } }
                }

                if root.page-mode == 0: Rectangle {
                    height: root.compact ? 176px : (root.first-offset() + root.days-in-month(root.year, root.month) > 35 ? 252px : 214px);
                    for label[i] in ["一", "二", "三", "四", "五", "六", "日"]: Text {
                        x: i * parent.width / 7; y: 0px; width: parent.width / 7; height: root.compact ? 20px : 24px;
                        text: label; color: i >= 5 ? Theme.weekend : Theme.text-2; font-size: Theme.font-13; font-weight: 600;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                    for row in (root.first-offset() + root.days-in-month(root.year, root.month) > 35 ? 6 : 5): Rectangle {
                        x: 0px; y: root.compact ? 20px + row * 26px : 28px + row * 38px; width: parent.width; height: root.compact ? 26px : 34px;
                        for column in 7: CalendarDayButton {
                            property <int> value: row * 7 + column - root.first-offset() + 1;
                            x: column * parent.width / 7 + (parent.width / 7 - (root.compact ? 26px : 34px)) / 2;
                            y: 0px; width: root.compact ? 26px : 34px; height: root.compact ? 26px : 34px;
                            day: value >= 1 && value <= root.days-in-month(root.year, root.month) ? value : 0;
                            selected: value == root.day;
                            weekend: column >= 5;
                            clicked => {
                                if (value > 0) {
                                    root.day = value;
                                    if (root.auto-accept) {
                                        root.accepted(root.year, root.month, root.day);
                                        root.page-mode = 0;
                                        root.close();
                                    }
                                }
                            }
                        }
                    }
                }

                if root.page-mode == 1: VerticalLayout {
                    height: root.compact ? 176px : 236px; spacing: 8px;
                    for row in 3: HorizontalLayout { spacing: 6px;
                        for column in 4: PickerButton {
                            property <int> value: root.year-base() + row * 4 + column;
                            horizontal-stretch: 1; height: root.compact ? 52px : 68px; label: value; selected: value == root.year;
                            clicked => { root.year = value; root.clamp-day(); root.page-mode = 0; }
                        }
                    }
                }

                if root.page-mode == 2: VerticalLayout {
                    height: root.compact ? 176px : 236px; spacing: 8px;
                    for row in 3: HorizontalLayout { spacing: 6px;
                        for column in 4: PickerButton {
                            property <int> value: row * 4 + column + 1;
                            horizontal-stretch: 1; height: root.compact ? 52px : 68px; label: value + "月"; selected: value == root.month;
                            clicked => { root.month = value; root.clamp-day(); root.page-mode = 0; }
                        }
                    }
                }
                Rectangle { vertical-stretch: 1; }
            }
            Rectangle {
                height: root.compact ? 44px : 52px; background: Theme.bg-surface-2; border-width: 1px; border-color: Theme.border-subtle;
                HorizontalLayout { padding-left: 14px; padding-right: 14px; spacing: 8px; cross-axis-alignment: center;
                    Text { text: root.year + "-" + (root.month < 10 ? "0" : "") + root.month + "-" + (root.day < 10 ? "0" : "") + root.day; color: Theme.text-2; font-size: root.compact ? Theme.font-13 : Theme.font-14; horizontal-stretch: 1; vertical-alignment: center; }
                    PickerButton { width: root.compact ? 60px : 66px; height: root.compact ? 30px : 34px; label: "取消"; clicked => { root.page-mode = 0; root.close(); root.canceled(); } }
                    PickerButton { width: root.compact ? 60px : 66px; height: root.compact ? 30px : 34px; label: "确定"; primary: true; clicked => { root.accepted(root.year, root.month, root.day); root.page-mode = 0; root.close(); } }
                }
            }
        }
    }
}

component ClockNumber inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback clicked();
    width: 26px; height: 26px; border-radius: 13px;
    background: selected ? Theme.accent : (touch.has-hover ? Theme.bg-hover : transparent);
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    Text { text: root.label; color: selected ? Theme.on-accent : Theme.text-1; font-size: Theme.font-12; font-weight: selected ? 700 : 600; horizontal-alignment: center; vertical-alignment: center; }
}

export component TimeHubTimePickerPopup inherits PopupWindow {
    in property <string> title: "选择时间";
    in property <bool> compact: false;
    in-out property <int> hour: 9;
    in-out property <int> minute: 0;
    in-out property <bool> selecting-hour: true;
    callback accepted(int, int);
    callback canceled();
    pure function pad-two(value: int) -> string { return value < 10 ? "0" + value : value; }
    pure function hour-index() -> int { return Math.mod(root.hour, 12); }
    function set-half(pm: bool) {
        if pm && root.hour < 12 { root.hour += 12; }
        if !pm && root.hour >= 12 { root.hour -= 12; }
    }
    function adjust-minute(delta: int) {
        root.minute = Math.mod(root.minute + delta + 60, 60);
    }

    width: root.compact ? 228px : 244px;
    // PopupWindow 的原生窗口尺寸在 show() 时确定。若这里随 selecting-hour
    // 从 300px 增长到 324px，Windows 上内容会增长但原生窗口仍保持旧高度，
    // 分钟微调行就会把底部的取消/确定按钮推出可见区域。始终预留最大高度。
    height: root.compact ? 314px : 324px;
    close-policy: PopupClosePolicy.no-auto-close;
    Rectangle {
        width: 100%; height: 100%; background: Theme.bg-surface;
        border-width: 1px; border-color: Theme.border-default; border-radius: Theme.r-lg;
        drop-shadow-color: Theme.shadow-3-color-a; drop-shadow-blur: Theme.shadow-3-blur-a; drop-shadow-offset-y: Theme.shadow-3-y-a;
        clip: true;
        VerticalLayout { spacing: 0px;
            Rectangle { height: 40px; background: Theme.bg-surface-2;
                HorizontalLayout { padding-left: 12px; padding-right: 6px; spacing: 6px; cross-axis-alignment: center;
                    SvgIcon { source: Icons.clock; size: 15px; tint: Theme.accent; }
                    Text { text: root.title; color: Theme.text-1; font-size: Theme.font-14; font-weight: 700; horizontal-stretch: 1; vertical-alignment: center; }
                    IconPickerButton { icon: Icons.close; clicked => { root.selecting-hour = true; root.close(); root.canceled(); } }
                }
            }
            VerticalLayout { padding-left: 12px; padding-right: 12px; padding-top: 6px; spacing: 3px;
                HorizontalLayout { height: 40px; alignment: center; spacing: 6px;
                    Rectangle { width: 66px; height: 40px; border-radius: Theme.r-md; border-width: 2px; border-color: root.selecting-hour ? Theme.accent : Theme.border-default; background: root.selecting-hour ? Theme.accent-subtle : Theme.bg-surface-2;
                        Text { text: root.pad-two(root.hour); color: root.selecting-hour ? Theme.accent : Theme.text-1; font-size: Theme.font-26; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { mouse-cursor: pointer; clicked => { root.selecting-hour = true; } }
                    }
                    Text { text: ":"; color: Theme.text-1; font-size: Theme.font-22; font-weight: 700; vertical-alignment: center; }
                    Rectangle { width: 66px; height: 40px; border-radius: Theme.r-md; border-width: 2px; border-color: !root.selecting-hour ? Theme.accent : Theme.border-default; background: !root.selecting-hour ? Theme.accent-subtle : Theme.bg-surface-2;
                        Text { text: root.pad-two(root.minute); color: !root.selecting-hour ? Theme.accent : Theme.text-1; font-size: Theme.font-26; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { mouse-cursor: pointer; clicked => { root.selecting-hour = false; } }
                    }
                }
                HorizontalLayout { height: 24px; alignment: center; spacing: 6px;
                    PickerButton { width: 70px; height: 24px; label: "上午"; selected: root.hour < 12; clicked => { root.set-half(false); } }
                    PickerButton { width: 70px; height: 24px; label: "下午"; selected: root.hour >= 12; clicked => { root.set-half(true); } }
                }
                HorizontalLayout { height: 132px; alignment: center;
                    clock := Rectangle { width: 132px; height: 132px; border-radius: 66px; background: Theme.bg-surface-2; border-width: 1px; border-color: Theme.border-subtle;
                        Rectangle { x: parent.width / 2 - 2px; y: parent.height / 2 - 2px; width: 4px; height: 4px; border-radius: 2px; background: Theme.accent; }
                        for i in 12: ClockNumber {
                            property <angle> angle: -90deg + i * 30deg;
                            x: parent.width / 2 + 50px * Math.cos(angle) - self.width / 2;
                            y: parent.height / 2 + 50px * Math.sin(angle) - self.height / 2;
                            label: root.selecting-hour ? (i == 0 ? "12" : i) : root.pad-two(i * 5);
                            selected: root.selecting-hour ? i == root.hour-index() : i * 5 == root.minute;
                            clicked => {
                                if root.selecting-hour {
                                    root.hour = i == 0 ? (root.hour >= 12 ? 12 : 0) : i + (root.hour >= 12 ? 12 : 0);
                                    root.selecting-hour = false;
                                } else { root.minute = i * 5; }
                            }
                        }
                    }
                }
                HorizontalLayout { height: root.selecting-hour ? 0px : 22px; visible: !root.selecting-hour; alignment: center; spacing: 6px;
                    PickerButton { width: 78px; height: 22px; label: "−1 分钟"; clicked => { root.adjust-minute(-1); } }
                    PickerButton { width: 78px; height: 22px; label: "+1 分钟"; clicked => { root.adjust-minute(1); } }
                }
                Rectangle { vertical-stretch: 1; }
            }
            Rectangle { height: 42px; background: Theme.bg-surface-2; border-width: 1px; border-color: Theme.border-subtle;
                HorizontalLayout { padding-left: 10px; padding-right: 10px; spacing: 6px; cross-axis-alignment: center;
                    Text { text: root.pad-two(root.hour) + ":" + root.pad-two(root.minute); color: Theme.text-2; font-size: Theme.font-13; font-weight: 600; horizontal-stretch: 1; vertical-alignment: center; }
                    PickerButton { width: 54px; height: 28px; label: "取消"; clicked => { root.selecting-hour = true; root.close(); root.canceled(); } }
                    PickerButton { width: 54px; height: 28px; label: "确定"; primary: true; clicked => { root.accepted(root.hour, root.minute); root.selecting-hour = true; root.close(); } }
                }
            }
        }
    }
}
