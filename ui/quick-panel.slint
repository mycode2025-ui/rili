import { Theme } from "theme.slint";
import { Icons, SvgIcon } from "icons.slint";
import { CalendarDay } from "calendar-view.slint";
import { EventItem, TodoItem } from "side-panel.slint";

export { Theme }

component QuickChip inherits Rectangle {
    in property <string> label;
    callback clicked();
    height: 30px; border-radius: Theme.r-md; border-width: 1px;
    border-color: touch.has-hover ? Theme.border-strong : Theme.border-default;
    background: touch.pressed ? Theme.accent-subtle : (touch.has-hover ? Theme.bg-hover : Theme.bg-surface-2);
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    Text { text: root.label; color: Theme.text-1; font-size: Theme.font-11-5; horizontal-alignment: center; vertical-alignment: center; }
}

component QuickNavButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> active;
    callback clicked();
    width: 44px;
    height: 34px;
    border-radius: Theme.r-md;
    background: touch.pressed ? Theme.accent-subtle : (active ? Theme.accent-subtle : (touch.has-hover ? Theme.bg-hover : transparent));
    accessible-role: button;
    accessible-label: root.label;
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    SvgIcon {
        source: root.icon;
        size: 20px;
        tint: active ? Theme.accent : (touch.has-hover ? Theme.text-1 : Theme.text-3);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    if touch.has-hover: Rectangle {
        x: (parent.width - self.width) / 2;
        y: -34px;
        width: 68px;
        height: 26px;
        border-radius: Theme.r-md;
        background: Theme.text-1;
        drop-shadow-color: Theme.shadow-1-color-a;
        drop-shadow-blur: Theme.shadow-1-blur-a;
        drop-shadow-offset-y: Theme.shadow-1-y;
        Text {
            text: root.label;
            color: Theme.bg-surface;
            font-size: Theme.font-10-5;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

component QuickSettingToggle inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <bool> checked;
    callback toggled();
    height: 54px;
    border-radius: Theme.r-md;
    background: touch.has-hover ? Theme.bg-hover : transparent;
    HorizontalLayout {
        padding-left: Theme.space-3; padding-right: Theme.space-3; spacing: Theme.space-3; cross-axis-alignment: center;
        VerticalLayout {
            horizontal-stretch: 1; alignment: center; spacing: 2px;
            Text { text: root.title; color: Theme.text-1; font-size: Theme.font-12; font-weight: 600; }
            Text { text: root.description; color: Theme.text-3; font-size: Theme.font-10; overflow: elide; }
        }
        Rectangle {
            width: 36px; height: 20px; border-radius: 10px;
            background: root.checked ? Theme.accent : Theme.bg-surface-2;
            border-width: root.checked ? 0px : 1px; border-color: Theme.border-default;
            Rectangle { width: 16px; height: 16px; border-radius: 8px; x: root.checked ? 18px : 2px; y: 2px; background: Theme.bg-surface; }
        }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.toggled(); } }
}

component QuickEvent inherits Rectangle {
    in property <EventItem> event;
    callback open();
    height: 43px; border-radius: Theme.r-md; border-width: 1px; border-color: Theme.border-subtle; background: Theme.bg-surface;
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.open(); } }
    HorizontalLayout {
        width: 100%; height: 100%;
        padding-left: Theme.space-2; padding-right: Theme.space-2; spacing: Theme.space-2;
        cross-axis-alignment: center;
        Rectangle { width: 3px; height: 28px; border-radius: 2px; background: event.color; }
        Text { width: 34px; text: event.time-text; color: Theme.text-3; font-size: Theme.font-10; vertical-alignment: center; }
        Text { text: event.title; color: Theme.text-1; font-size: Theme.font-11-5; overflow: elide; vertical-alignment: center; }
    }
}

component QuickTodo inherits Rectangle {
    in property <TodoItem> todo;
    callback toggle();
    height: 44px;
    touch := TouchArea { mouse-cursor: pointer; clicked => { toggle(); } }
    HorizontalLayout {
        width: 100%; height: 100%;
        padding-left: Theme.space-2; spacing: Theme.space-2;
        cross-axis-alignment: center;
        Rectangle {
            width: 16px; height: 16px; border-radius: 5px; border-width: todo.done ? 0px : 1px; border-color: Theme.border-strong; background: todo.done ? Theme.accent : transparent;
            if todo.done: SvgIcon { source: Icons.check; size: 11px; tint: Theme.on-accent; x: 2.5px; y: 2.5px; }
        }
        Text { text: todo.title; color: todo.done ? Theme.text-disabled : Theme.text-1; font-size: Theme.font-12; overflow: elide; vertical-alignment: center; }
    }
}

component PanelDay inherits Rectangle {
    in property <CalendarDay> day;
    callback select();
    min-width: 0px;
    preferred-width: 0px;
    horizontal-stretch: 1;
    height: 26px; border-radius: Theme.r-sm; background: day.is-today ? Theme.accent : transparent;
    touch := TouchArea { mouse-cursor: day.in-current-month ? pointer : default; clicked => { if (day.in-current-month) { root.select(); } } }
    Text {
        x: 0; y: 0; width: 100%; height: 100%;
        text: day.day;
        color: day.is-today ? Theme.on-accent : (!day.in-current-month ? Theme.text-disabled : (day.is-weekend ? Theme.weekend : Theme.text-1));
        font-size: Theme.font-10; font-weight: day.is-today ? 700 : 400;
        horizontal-alignment: center; vertical-alignment: center;
    }
}

component PanelWeekday inherits Rectangle {
    in property <string> label;
    in property <bool> weekend;
    min-width: 0px;
    preferred-width: 0px;
    horizontal-stretch: 1;
    height: 20px;
    Text {
        x: 0; y: 0; width: 100%; height: 100%;
        text: root.label;
        color: root.weekend ? Theme.weekend : Theme.text-3;
        font-size: Theme.font-10;
        horizontal-alignment: center; vertical-alignment: center;
    }
}

export component QuickPanelWindow inherits Window {
    title: "TimeHub 快速面板";
    default-font-family: Theme.font-family;
    icon: Icons.app-logo;
    width: 460px; height: 640px; no-frame: true;
    always-on-top: root.pinned;
    background: Theme.bg-surface;
    in property <[CalendarDay]> days;
    in property <[EventItem]> events;
    in property <[TodoItem]> todos;
    in property <string> time-text;
    in property <string> weather-text;
    in property <string> date-title;
    in property <string> weekday-text;
    in property <string> lunar-text;
    in property <string> month-title;
    in property <int> countdown-count;
    in property <int> active-view;
    in-out property <bool> pinned: false;
    in-out property <bool> settings-open: false;
    callback toggle-todo(int);
    callback open-view(int);
    callback open-event(int);
    callback select-day(int);
    callback new-event();
    callback close-requested();
    callback pin-changed(bool);

    Rectangle {
        width: 100%; height: 100%; background: Theme.bg-surface;
        border-width: 1px; border-color: Theme.border-default; border-radius: Theme.r-xl; clip: true;
        VerticalLayout {
            width: 100%; height: 100%; spacing: 0px;
            VerticalLayout {
                height: 112px; padding-left: Theme.space-5; padding-right: Theme.space-5; padding-top: Theme.space-4; padding-bottom: Theme.space-3; spacing: Theme.space-3;
                HorizontalLayout {
                    spacing: Theme.space-2;
                    Text { text: root.date-title; color: Theme.text-1; font-size: Theme.font-26; font-weight: 700; vertical-alignment: center; }
                    Text { text: root.weekday-text; color: Theme.text-1; font-size: Theme.font-12; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: root.lunar-text; color: Theme.text-1; font-size: Theme.font-11-5; vertical-alignment: center; overflow: elide; }
                    Rectangle { width: 30px; }
                }
                HorizontalLayout {
                    spacing: Theme.space-2;
                    QuickChip { horizontal-stretch: 1; label: "日程 " + events.length; clicked => { root.open-view(2); } }
                    QuickChip { horizontal-stretch: 1; label: "待办 " + todos.length; clicked => { root.open-view(4); } }
                    QuickChip { horizontal-stretch: 1; label: "节日 0"; clicked => { root.open-view(2); } }
                    QuickChip { horizontal-stretch: 1; label: "倒数日 " + root.countdown-count; clicked => { root.open-view(8); } }
                }
            }
            Rectangle { height: 1px; background: Theme.border-subtle; }
            HorizontalLayout {
                vertical-stretch: 1; spacing: 0px;
                VerticalLayout {
                    width: 242px; padding: Theme.space-4; spacing: 10px;
                    Text { height: 20px; text: "今日日程"; color: Theme.text-3; font-size: Theme.font-11; font-weight: 600; vertical-alignment: center; }
                    for event in events: QuickEvent { event: event; open => { root.open-event(event.id); } }
                    if events.length == 0: Rectangle {
                        height: 56px; border-radius: Theme.r-md; border-width: 1px; border-color: Theme.border-subtle; background: Theme.bg-surface-2;
                        Text { text: "今天暂无日程"; color: Theme.text-2; font-size: Theme.font-11; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Text { height: 20px; text: "今日待办"; color: Theme.text-3; font-size: Theme.font-11; font-weight: 600; vertical-alignment: center; }
                    for todo in todos: QuickTodo { todo: todo; toggle => { root.toggle-todo(todo.id); } }
                    if todos.length == 0: Rectangle {
                        height: 56px; border-radius: Theme.r-md; border-width: 1px; border-color: Theme.border-subtle; background: Theme.bg-surface-2;
                        Text { text: "今天暂无待办"; color: Theme.text-2; font-size: Theme.font-11; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Rectangle { vertical-stretch: 1; }
                }
                Rectangle { width: 1px; background: Theme.border-subtle; }
                VerticalLayout {
                    padding: Theme.space-4; spacing: Theme.space-3;
                    Text { text: time-text == "" ? "22:53:12" : time-text; color: Theme.text-1; font-size: Theme.font-32; font-weight: 600; }
                    HorizontalLayout { spacing: Theme.space-2; cross-axis-alignment: center; SvgIcon { source: Icons.cloud; size: 14px; tint: Theme.text-2; } Text { text: weather-text == "" ? "上海 26°C 多云 · 湿度 68%" : weather-text; color: Theme.text-2; font-size: Theme.font-11; vertical-alignment: center; } }
                    Text { text: root.month-title; color: Theme.text-1; font-size: Theme.font-11; font-weight: 600; }
                    HorizontalLayout {
                        spacing: 0px;
                        for label[i] in ["一", "二", "三", "四", "五", "六", "日"]: PanelWeekday {
                            label: label;
                            weekend: i >= 5;
                        }
                    }
                    for week in 6: HorizontalLayout {
                        height: 26px;
                        spacing: 0px;
                        for col in 7: PanelDay {
                            day: days[week * 7 + col];
                            select => { root.select-day(days[week * 7 + col].day); }
                        }
                    }
                    Rectangle { vertical-stretch: 1; }
                }
            }
            Rectangle {
                height: 55px; background: Theme.bg-surface-2; border-width: 1px; border-color: Theme.border-subtle;
                HorizontalLayout {
                    width: 100%; height: 100%;
                    padding-top: 10px; padding-bottom: 10px; spacing: 0px;
                    cross-axis-alignment: center;
                    Rectangle { horizontal-stretch: 1; QuickNavButton { x: (parent.width - self.width) / 2; icon: Icons.today; label: "今天"; active: root.active-view == 2 || root.active-view == 3; clicked => { root.open-view(2); } } }
                    Rectangle { horizontal-stretch: 1; QuickNavButton { x: (parent.width - self.width) / 2; icon: Icons.calendar; label: "月历"; active: root.active-view == 0 || root.active-view == 1 || root.active-view == 5; clicked => { root.open-view(0); } } }
                    Rectangle { horizontal-stretch: 1; QuickNavButton { x: (parent.width - self.width) / 2; icon: Icons.check; label: "待办"; active: root.active-view == 4; clicked => { root.open-view(4); } } }
                    Rectangle { horizontal-stretch: 1; QuickNavButton { x: (parent.width - self.width) / 2; icon: Icons.plus; label: "新建"; active: false; clicked => { root.new-event(); } } }
                    Rectangle { horizontal-stretch: 1; QuickNavButton { x: (parent.width - self.width) / 2; icon: Icons.gear; label: "设置"; active: root.settings-open; clicked => { root.settings-open = !root.settings-open; } } }
                }
            }
        }
    }

    close-button := Rectangle {
        x: parent.width - 42px; y: 12px; width: 30px; height: 30px; border-radius: Theme.r-md;
        background: close-touch.pressed ? Theme.danger-bg : (close-touch.has-hover ? Theme.bg-hover : transparent);
        accessible-role: button; accessible-label: "关闭快速面板";
        SvgIcon { source: Icons.close; size: 15px; tint: close-touch.has-hover ? Theme.danger : Theme.text-2; x: 7.5px; y: 7.5px; }
        close-touch := TouchArea { mouse-cursor: pointer; clicked => { root.settings-open = false; root.close-requested(); } }
    }

    if root.settings-open: Rectangle {
        width: parent.width; height: parent.height; background: transparent;
        dismiss := TouchArea { clicked => { root.settings-open = false; } }
        settings-card := Rectangle {
            x: parent.width - self.width - 16px; y: parent.height - self.height - 66px;
            width: 292px; height: 210px; border-radius: Theme.r-lg;
            background: Theme.bg-surface; border-width: 1px; border-color: Theme.border-default;
            drop-shadow-color: Theme.shadow-3-color-a; drop-shadow-blur: Theme.shadow-3-blur-a; drop-shadow-offset-y: Theme.shadow-3-y-a;
            VerticalLayout {
                padding: Theme.space-3; spacing: Theme.space-2;
                HorizontalLayout { height: 30px; spacing: Theme.space-2; cross-axis-alignment: center;
                    SvgIcon { source: Icons.gear; size: 17px; tint: Theme.accent; }
                    Text { text: "快速面板设置"; color: Theme.text-1; font-size: Theme.font-13; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                    Rectangle { width: 26px; height: 26px; border-radius: Theme.r-sm; background: settings-close-touch.has-hover ? Theme.bg-hover : transparent;
                        SvgIcon { source: Icons.close; size: 13px; tint: Theme.text-2; x: 6.5px; y: 6.5px; }
                        settings-close-touch := TouchArea { mouse-cursor: pointer; clicked => { root.settings-open = false; } }
                    }
                }
                QuickSettingToggle {
                    title: "窗口置顶";
                    description: "让快速面板保持在其他窗口上方";
                    checked: root.pinned;
                    toggled => { root.pinned = !root.pinned; root.pin-changed(root.pinned); }
                }
                Rectangle {
                    height: 38px; border-radius: Theme.r-md;
                    background: Theme.bg-surface-2;
                    HorizontalLayout {
                        padding-left: Theme.space-3; padding-right: Theme.space-3; spacing: Theme.space-2; cross-axis-alignment: center;
                        SvgIcon { source: Icons.layout; size: 15px; tint: Theme.text-2; }
                        Text { text: "位置固定在任务栏右下角"; color: Theme.text-1; font-size: Theme.font-11; vertical-alignment: center; }
                    }
                }
                Text { text: "每次打开都会自动回到系统时钟上方。"; color: Theme.text-3; font-size: Theme.font-10; wrap: word-wrap; }
            }
        }
    }
}
