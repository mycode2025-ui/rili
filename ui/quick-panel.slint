import { Theme } from "theme.slint";
import { Icons, SvgIcon } from "icons.slint";
import { CalendarDay } from "calendar-view.slint";
import { EventItem, TodoItem } from "side-panel.slint";
import { WeatherArtwork } from "weather-artwork.slint";
import { FocusTouchArea } from "widgets.slint";

export { Theme }

component HeaderButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> danger: false;
    callback clicked();
    width: 32px;
    height: 32px;
    border-radius: Theme.r-md;
    background: touch.pressed ? (danger ? Theme.danger-bg : Theme.accent-subtle) : (touch.has-hover ? Theme.bg-hover : transparent);
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { root.clicked(); }
    forward-focus: touch;
    border-width: touch.has-focus ? 2px : 0px;
    border-color: Theme.accent;
    touch := FocusTouchArea { width: 100%; height: 100%; clicked => { root.clicked(); } }
    SvgIcon {
        source: root.icon;
        size: 16px;
        tint: root.danger && touch.has-hover ? Theme.danger : (touch.has-hover ? Theme.text-1 : Theme.text-2);
        x: 8px;
        y: 8px;
    }
    if touch.has-hover: Rectangle {
        x: (parent.width - 72px) / 2;
        y: 34px;
        width: 72px;
        height: 25px;
        border-radius: Theme.r-md;
        background: Theme.text-1;
        drop-shadow-color: Theme.shadow-1-color-a;
        drop-shadow-blur: Theme.shadow-1-blur-a;
        drop-shadow-offset-y: Theme.shadow-1-y;
        Text { text: root.label; color: Theme.bg-surface; font-size: Theme.font-10; horizontal-alignment: center; vertical-alignment: center; }
    }
}

component MonthButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    callback clicked();
    width: label == "" ? 28px : 48px;
    height: 28px;
    border-radius: Theme.r-md;
    background: touch.pressed ? Theme.accent-subtle : (touch.has-hover ? Theme.bg-hover : transparent);
    accessible-role: button;
    accessible-label: label == "" ? "切换月份" : label;
    accessible-action-default => { root.clicked(); }
    forward-focus: touch;
    border-width: touch.has-focus ? 2px : 0px;
    border-color: Theme.accent;
    touch := FocusTouchArea { width: 100%; height: 100%; clicked => { root.clicked(); } }
    if label == "": SvgIcon { source: root.icon; size: 14px; tint: touch.has-hover ? Theme.accent : Theme.text-2; x: 7px; y: 7px; }
    if label != "": Text { text: root.label; color: touch.has-hover ? Theme.accent : Theme.text-2; font-size: Theme.font-11; horizontal-alignment: center; vertical-alignment: center; }
}

component WeekdayCell inherits Rectangle {
    in property <string> label;
    in property <bool> weekend;
    min-width: 0px;
    preferred-width: 0px;
    horizontal-stretch: 1;
    height: 22px;
    Text { text: root.label; color: weekend ? Theme.weekend : Theme.text-2; font-size: Theme.font-11; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
}

component CalendarDayCell inherits Rectangle {
    in property <CalendarDay> day;
    callback select();
    min-width: 0px;
    preferred-width: 0px;
    horizontal-stretch: 1;
    height: 40px;
    border-radius: Theme.r-md;
    border-width: touch.has-focus ? 2px : 0px;
    border-color: Theme.accent;
    background: day.is-today ? Theme.accent-subtle : (touch.has-hover && day.in-current-month ? Theme.bg-hover : transparent);
    accessible-role: button;
    accessible-label: day.in-current-month ? "选择 " + day.day + " 日" : "非本月日期";
    accessible-action-default => { if (day.in-current-month) { root.select(); } }
    forward-focus: touch;
    touch := FocusTouchArea { width: 100%; height: 100%; enabled: day.in-current-month; clicked => { root.select(); } }
    Text {
        x: 0px;
        y: 2px;
        width: 100%;
        height: 19px;
        text: day.day;
        color: day.is-today ? Theme.accent : (!day.in-current-month ? Theme.text-disabled : (day.is-weekend ? Theme.weekend : Theme.text-1));
        font-size: Theme.font-13;
        font-weight: day.is-today ? 700 : 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Text {
        x: 3px;
        y: 21px;
        width: parent.width - 6px;
        height: 13px;
        text: day.special-text != "" ? day.special-text : day.lunar-text;
        color: day.special-text != "" ? Theme.accent : (day.in-current-month ? Theme.text-3 : Theme.text-disabled);
        font-size: Theme.font-10;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
    if day.has-events: Rectangle {
        x: (parent.width - 4px) / 2;
        y: 35px;
        width: 4px;
        height: 4px;
        border-radius: 2px;
        background: day.is-today ? Theme.accent : Theme.info;
    }
}

component OverviewCard inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <string> value;
    in property <color> tint: Theme.accent;
    callback clicked();
    min-width: 0px;
    preferred-width: 0px;
    horizontal-stretch: 1;
    height: 62px;
    border-radius: Theme.r-lg;
    border-width: 1px;
    border-color: touch.has-hover ? tint.with-alpha(55%) : Theme.border-subtle;
    background: touch.pressed ? tint.with-alpha(14%) : (touch.has-hover ? Theme.bg-hover : Theme.bg-surface-2);
    accessible-role: button;
    accessible-label: root.label + "，" + root.value;
    accessible-action-default => { root.clicked(); }
    forward-focus: touch;
    touch := FocusTouchArea { width: 100%; height: 100%; clicked => { root.clicked(); } }
    Rectangle { x: 8px; y: 12px; width: 36px; height: 36px; border-radius: Theme.r-md; background: tint.with-alpha(16%); SvgIcon { source: root.icon; size: 20px; tint: root.tint; x: 8px; y: 8px; } }
    Text { x: 52px; y: 10px; width: parent.width - 60px; height: 20px; text: root.value; color: Theme.text-1; font-size: Theme.font-14; font-weight: 700; vertical-alignment: center; }
    Text { x: 52px; y: 31px; width: parent.width - 60px; height: 18px; text: root.label; color: Theme.text-2; font-size: Theme.font-11; font-weight: 500; vertical-alignment: center; overflow: elide; }
}

component BottomNavButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> active;
    callback clicked();
    min-width: 0px;
    preferred-width: 0px;
    horizontal-stretch: 1;
    height: 54px;
    border-radius: Theme.r-md;
    background: touch.pressed ? Theme.accent-subtle : (touch.has-hover ? Theme.bg-hover : transparent);
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    forward-focus: touch;
    border-width: touch.has-focus ? 2px : 0px;
    border-color: Theme.accent;
    touch := FocusTouchArea { width: 100%; height: 100%; clicked => { root.clicked(); } }
    if active: Rectangle { x: (parent.width - 24px) / 2; y: 2px; width: 24px; height: 3px; border-radius: 1.5px; background: Theme.accent; }
    SvgIcon { source: root.icon; size: 20px; tint: active ? Theme.accent : (touch.has-hover ? Theme.text-1 : Theme.text-2); x: (parent.width - self.width) / 2; y: 8px; }
    Text { x: 0px; y: 32px; width: 100%; height: 18px; text: root.label; color: active ? Theme.accent : Theme.text-2; font-size: Theme.font-11; font-weight: 500; horizontal-alignment: center; vertical-alignment: center; }
}

component AddButton inherits Rectangle {
    callback clicked();
    width: 48px;
    height: 48px;
    border-radius: 24px;
    background: touch.pressed ? Theme.accent-pressed : (touch.has-hover ? Theme.accent-hover : Theme.accent);
    drop-shadow-color: Theme.accent.with-alpha(36%);
    drop-shadow-blur: 10px;
    drop-shadow-offset-y: 4px;
    accessible-role: button;
    accessible-label: "新建日程";
    accessible-action-default => { root.clicked(); }
    forward-focus: touch;
    border-width: touch.has-focus ? 2px : 0px;
    border-color: Theme.on-accent;
    touch := FocusTouchArea { width: 100%; height: 100%; clicked => { root.clicked(); } }
    SvgIcon { source: Icons.plus; size: 24px; tint: Theme.on-accent; x: 12px; y: 12px; }
    if touch.has-hover: Rectangle {
        x: (parent.width - 76px) / 2;
        y: -31px;
        width: 76px;
        height: 25px;
        border-radius: Theme.r-md;
        background: Theme.text-1;
        Text { text: "新建日程"; color: Theme.bg-surface; font-size: Theme.font-10; horizontal-alignment: center; vertical-alignment: center; }
    }
}

export component QuickPanelWindow inherits Window {
    title: "TimeHub 快速面板";
    default-font-family: Theme.font-family;
    icon: Icons.app-logo;
    width: 460px;
    height: 640px;
    no-frame: true;
    always-on-top: root.pinned;
    background: transparent;

    in property <[CalendarDay]> days;
    in property <[EventItem]> events;
    in property <[TodoItem]> todos;
    in property <string> time-text;
    in property <string> weather-city;
    in property <string> weather-temperature;
    in property <string> weather-description;
    in property <string> weather-icon-kind: "unknown";
    in property <string> weather-updated;
    in property <string> weather-provider;
    in property <bool> weather-refreshing: false;
    in property <bool> weather-refresh-error: false;
    in property <string> date-title;
    in property <string> weekday-text;
    in property <string> lunar-text;
    in property <string> month-title;
    in-out property <int> browse-year: 0;
    in-out property <int> browse-month: 0;
    in property <int> countdown-count;
    in property <int> active-view;
    in-out property <bool> pinned: false;
    callback toggle-todo(int);
    callback open-view(int);
    callback open-event(int, string);
    callback select-day(int);
    callback prev-month();
    callback next-month();
    callback goto-today();
    callback new-event();
    callback open-settings();
    callback close-requested();
    callback open-weather();
    callback refresh-weather();

    Rectangle {
        // A 4px inset stays on whole physical pixels at 100%, 125%, 150%
        // and 200% scaling. The former 5px inset shifted the entire content
        // tree by half a physical pixel at 150%, softening every glyph.
        x: 4px;
        y: 4px;
        width: parent.width - 8px;
        height: parent.height - 8px;
        border-radius: Theme.r-xl;
        border-width: 1px;
        border-color: Theme.border-default;
        background: Theme.bg-surface;
        clip: true;
        drop-shadow-color: Theme.shadow-3-color-a;
        drop-shadow-blur: Theme.shadow-3-blur-a;
        drop-shadow-offset-y: Theme.shadow-3-y-a;

        VerticalLayout {
            width: 100%;
            height: 100%;
            spacing: 0px;

            Rectangle {
                height: 108px;
                background: Theme.accent-subtle;
                Rectangle { x: parent.width - 126px; y: -50px; width: 176px; height: 176px; border-radius: 88px; background: Theme.accent.with-alpha(7%); }
                Rectangle { x: parent.width - 74px; y: 40px; width: 110px; height: 110px; border-radius: 55px; background: Theme.accent.with-alpha(6%); }
                Text { x: 20px; y: 12px; width: 260px; height: 48px; text: root.time-text == "" ? "17:51:29" : root.time-text; color: Theme.text-1; font-size: Theme.font-44; font-weight: 700; vertical-alignment: center; }
                Text { x: 20px; y: 64px; width: 270px; height: 20px; text: root.date-title + "  " + root.weekday-text; color: Theme.text-2; font-size: Theme.font-13; font-weight: 500; vertical-alignment: center; }
                Text { x: 20px; y: 84px; width: 270px; height: 18px; text: root.lunar-text; color: Theme.text-2; font-size: Theme.font-11; font-weight: 500; vertical-alignment: center; overflow: elide; }
                Rectangle {
                    x: parent.width - 180px;
                    y: 36px;
                    width: 168px;
                    height: 64px;
                    border-radius: Theme.r-lg;
                    border-width: weather-card-touch.has-focus ? 2px : 0px;
                    border-color: Theme.accent;
                    background: weather-card-touch.has-hover ? Theme.bg-hover : Theme.bg-surface;
                    accessible-role: button;
                    accessible-label: root.weather-city == "" ? "打开天气" : "打开 " + root.weather-city + " 天气";
                    accessible-action-default => { root.open-weather(); }
                    forward-focus: weather-card-touch;
                    WeatherArtwork { x: 8px; y: 8px; width: 48px; height: 48px; kind: root.weather-icon-kind; }
                    if root.weather-city == "": Text {
                        x: 60px; y: 8px; width: 80px; height: 42px;
                        text: "天气加载中"; color: Theme.text-2; font-size: Theme.font-11;
                        vertical-alignment: center; overflow: elide;
                    }
                    if root.weather-city != "": Text {
                        x: 60px; y: 4px; width: 80px; height: 20px;
                        text: root.weather-city; color: Theme.text-1; font-size: Theme.font-11; font-weight: 600;
                        vertical-alignment: center; overflow: elide;
                    }
                    if root.weather-city != "": Text {
                        x: 60px; y: 22px; width: 48px; height: 22px;
                        text: root.weather-temperature; color: Theme.text-1; font-size: Theme.font-13; font-weight: 700;
                        vertical-alignment: center; overflow: elide;
                    }
                    if root.weather-city != "": Text {
                        x: 108px; y: 24px; width: 48px; height: 18px;
                        text: root.weather-description; color: Theme.text-2; font-size: Theme.font-11;
                        horizontal-alignment: right; vertical-alignment: center; overflow: elide;
                    }
                    Text {
                        x: 60px; y: 44px; width: 96px; height: 16px;
                        text: root.weather-refreshing ? "正在更新…"
                            : root.weather-refresh-error ? "更新失败 · 点击重试"
                            : root.weather-updated + (root.weather-provider == "" ? "" : " · " + root.weather-provider);
                        color: root.weather-refresh-error ? Theme.danger : Theme.text-2; font-size: Theme.font-10;
                        vertical-alignment: center; overflow: elide;
                    }
                    weather-card-touch := FocusTouchArea { width: 100%; height: 100%; clicked => { root.open-weather(); } }
                    Rectangle {
                        x: parent.width - 24px; y: 4px; width: 20px; height: 20px; border-radius: 10px;
                        background: refresh-touch.has-hover ? Theme.accent-subtle : transparent;
                        border-width: refresh-touch.has-focus ? 2px : 0px;
                        border-color: Theme.accent;
                        accessible-role: button;
                        accessible-label: "刷新天气";
                        accessible-action-default => { if (!root.weather-refreshing) { root.refresh-weather(); } }
                        forward-focus: refresh-touch;
                        SvgIcon { x: 4px; y: 4px; size: 12px; source: Icons.reload; tint: root.weather-refreshing ? Theme.text-3 : Theme.accent; }
                        refresh-touch := FocusTouchArea { width: 100%; height: 100%; enabled: !root.weather-refreshing; clicked => { root.refresh-weather(); } }
                    }
                }
                HeaderButton { x: parent.width - 76px; y: 8px; icon: Icons.gear; label: "打开设置"; clicked => { root.open-settings(); } }
                HeaderButton { x: parent.width - 40px; y: 8px; icon: Icons.close; label: "关闭面板"; danger: true; clicked => { root.close-requested(); } }
            }

            Rectangle {
                height: 332px;
                background: Theme.bg-surface;
                VerticalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    spacing: 2px;
                    HorizontalLayout {
                        height: 32px;
                        spacing: 4px;
                        Text { text: root.month-title; color: Theme.text-1; font-size: Theme.font-15; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                        MonthButton { icon: Icons.left; label: ""; clicked => { root.prev-month(); } }
                        MonthButton { icon: Icons.today; label: "今天"; clicked => { root.goto-today(); } }
                        MonthButton { icon: Icons.right; label: ""; clicked => { root.next-month(); } }
                    }
                    HorizontalLayout {
                        height: 22px;
                        spacing: 0px;
                        for label[i] in ["一", "二", "三", "四", "五", "六", "日"]: WeekdayCell { label: label; weekend: i >= 5; }
                    }
                    for week in 6: HorizontalLayout {
                        height: 40px;
                        spacing: 0px;
                        for col in 7: CalendarDayCell {
                            day: root.days[week * 7 + col];
                            select => { root.select-day(root.days[week * 7 + col].day); }
                        }
                    }
                }
            }

            Rectangle { height: 1px; background: Theme.border-subtle; }

            VerticalLayout {
                vertical-stretch: 1;
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 10px;
                padding-bottom: 10px;
                spacing: 8px;
                HorizontalLayout {
                    height: 20px;
                    Text { text: "今日概览"; color: Theme.text-1; font-size: Theme.font-13; font-weight: 700; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: events.length + todos.length == 0 ? "今天很轻松" : "安排得井井有条"; color: Theme.text-2; font-size: Theme.font-11; font-weight: 500; vertical-alignment: center; }
                }
                HorizontalLayout {
                    spacing: 6px;
                    OverviewCard { icon: Icons.calendar; value: events.length + " 项"; label: "日程安排"; tint: Theme.accent; clicked => { root.open-view(2); } }
                    OverviewCard { icon: Icons.check; value: todos.length + " 项"; label: "待办任务"; tint: Theme.success; clicked => { root.open-view(4); } }
                    OverviewCard { icon: Icons.timer; value: root.countdown-count + " 项"; label: "重要倒数"; tint: Theme.warning; clicked => { root.open-view(8); } }
                }
            }

            Rectangle {
                height: 64px;
                background: Theme.bg-surface-2;
                border-width: 1px;
                border-color: Theme.border-subtle;
                HorizontalLayout {
                    width: 100%;
                    height: 100%;
                    padding-left: 8px;
                    padding-right: 8px;
                    padding-top: 4px;
                    padding-bottom: 4px;
                    spacing: 4px;
                    BottomNavButton { icon: Icons.today; label: "今天"; active: root.active-view == 2 || root.active-view == 3; clicked => { root.open-view(2); } }
                    BottomNavButton { icon: Icons.calendar; label: "日历"; active: root.active-view == 0 || root.active-view == 1 || root.active-view == 5; clicked => { root.open-view(0); } }
                    Rectangle { min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; AddButton { x: (parent.width - self.width) / 2; y: 4px; clicked => { root.new-event(); } } }
                    BottomNavButton { icon: Icons.check; label: "待办"; active: root.active-view == 4; clicked => { root.open-view(4); } }
                    BottomNavButton { icon: Icons.gear; label: "设置"; active: false; clicked => { root.open-settings(); } }
                }
            }
        }
    }
}
