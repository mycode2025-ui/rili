    width: 960px; height: 640px; background: Theme.bg;
    init => { Theme.theme-mode = 2; }
    SearchView { x: 160px; y: 48px; width: 420px; height: 144px; }
}
export component SearchResultsPreview inherits Window {
    default-font-family: Theme.font-family;
    width: 960px; height: 640px; background: Theme.bg;
    init => { Theme.theme-mode = 2; }
    SearchView {
        x: 160px; y: 48px; width: 420px; height: 294px;
        query: "会议";
        results: [
            { id: 1, kind: "日程", title: "产品研发会议", meta: "明天 15:00 · 会议室 5", date: "2026-10-09" },
